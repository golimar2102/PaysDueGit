    m_LocalVariables: []
  npcName: "\u0420\u043E\u0431\u0435\u0440\u0442\u043E"
  dialogueCameraPoint: {fileID: 3192138910834509002}
  hasFirstTimeDialogue: 1
  firstTimeDialoguePlayed: 0
  dialogueSaveKey: 
  firstTimeNodes:
  - localizedNpcText:
      m_TableReference:
        m_TableCollectionName: 
      m_TableEntryReference:
        m_KeyId: 0
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    npcText: "\u041E-\u043E-\u043E, \u043D\u0443 \u0438 \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0432\u0435\u043A\u043E\u0432 \u0442\u0443\u0442 \u043D\u043E\u0432\u044B\u0445
      \u043B\u0438\u0446 \u043D\u0435 \u0431\u044B\u043B\u043E? \u041C\u043E\u0451
      \u043F\u043E\u0447\u0442\u0435\u043D\u0438\u0435, \u0437\u0430\u0431\u043B\u0443\u0434\u0448\u0430\u044F
      \u0434\u0443\u0448\u0430. \u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u0432 \u043D\u0438\u043A\u0443\u0434\u0430."
    npcTextEng: Well, well. Feels like actual eons since I last saw a fresh face
      around here. Greetings, lost soul. Welcome to nowhere.
    options:
    - localizedButtonText:
        m_TableReference:
          m_TableCollectionName: 
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: 
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
      buttonText: "\u0422\u044B \u043A\u0442\u043E?"
      buttonTextEng: Who are you?
      nextNodeIndex: 1
      npcAnimationStates: []
      playerAnimationStates: []
    - localizedButtonText:
        m_TableReference:
          m_TableCollectionName: 
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: 
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
      buttonText: "\u0427\u0442\u043E \u044D\u0442\u043E \u0437\u0430 \u043C\u0435\u0441\u0442\u043E?"
      buttonTextEng: What is that place?
      nextNodeIndex: 2
      npcAnimationStates: []
      playerAnimationStates: []
    npcAnimationStates:
    - Talk1
    playerAnimationStates: []
    displayRect:
      serializedVersion: 2
      x: 8
      y: 7
      width: 280
      height: 506
  - localizedNpcText:
      m_TableReference:
        m_TableCollectionName: 
      m_TableEntryReference:
        m_KeyId: 0
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    npcText: "\u041A\u0442\u043E \u044F? \u0425\u0435\u0445... \u0415\u0441\u043B\u0438
      \u0431\u044B \u044F \u0441\u0430\u043C \u0437\u043D\u0430\u043B. \u041A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u0443 \u043C\u0435\u043D\u044F \u0431\u044B\u043B\u043E \u0441\u0432\u043E\u0451
      \u0434\u0435\u043B\u043E. \u0414\u0443\u043C\u0430\u043B, \u0436\u0438\u0437\u043D\u044C
      \u0443\u0434\u0430\u043B\u0430\u0441\u044C. \u0410 \u043F\u043E\u0442\u043E\u043C...
      \u043D\u0443... \u0436\u0438\u0437\u043D\u044C \u0443\u043C\u0435\u0435\u0442
      \u043B\u043E\u043C\u0430\u0442\u044C. \u0412 \u043E\u0431\u0449\u0435\u043C,
      \u043F\u0435\u0440\u0435\u0434 \u0441\u043C\u0435\u0440\u0442\u044C\u044E \u044F
      \u0443\u0436\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A\u0441\u043E\u0432\u0430\u043B.
      \u042F \u0420\u043E\u0431\u0435\u0440\u0442\u043E."
    npcTextEng: Who am I? Heh... wish I knew. I used to have a business. Thought
      I made it. And then... well... life has a way of breaking you. Ended up driving
      a taxi before it all went dark. I'm Roberto.
    options:
    - localizedButtonText:
        m_TableReference:
          m_TableCollectionName: 
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: 
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
      buttonText: "\u0418 \u0442\u044B \u0434\u0430\u0432\u043D\u043E \u0442\u0443\u0442?"
      buttonTextEng: Have you been here long?
      nextNodeIndex: 3
      npcAnimationStates:
      - Yes
      playerAnimationStates: []
    - localizedButtonText:
        m_TableReference:
          m_TableCollectionName: 
        m_TableEntryReference:
          m_KeyId: 0
          m_Key: 
        m_FallbackState: 0
        m_WaitForCompletion: 0
        m_LocalVariables: []
      buttonText: "\u0422\u044B \u0447\u0442\u043E \u0442\u043E \u0441\u043A\u0430\u0437\u0430\u043B
        \u043F\u0440\u043E \u043D\u043E\u0432\u044B\u0445 \u043B\u0438\u0446."
      buttonTextEng: You said something about new faces.
      nextNodeIndex: 4
      npcAnimationStates: []
      playerAnimationStates: []
    npcAnimationStates:
    - Talk1
    playerAnimationStates: []
    displayRect:
      serializedVersion: 2
      x: 314
